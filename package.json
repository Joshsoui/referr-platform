{
  "name": "finderz-keeperz-scout-engine",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "clean": "rm -rf .next out",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "render-build": "npm install --include=dev && prisma generate && export DIRECT_URL=\"${DIRECT_URL:-$DATABASE_URL}\" && if [ -n \"$DATABASE_URL\" ]; then prisma migrate deploy; fi && next build",
    "start": "next start --hostname 0.0.0.0",
    "demo": "npm run clean && npm run build && npm run start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.511.0",
    "next": "15.5.19",
    "next-auth": "^5.0.0-beta.25",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stripe": "^22.4.0",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/bcryptjs": "^2.4.6",
    "dotenv": "^17.4.2",
    "eslint": "^9.27.0",
    "eslint-config-next": "15.5.19",
    "prisma": "^6.19.3"
  }
}
