{%- render 'breadcrumb', product: product, collection: collection -%}
{%- render 'schema-product' -%}

<section class="product-page">
  <div class="container">
    <div class="product-page__grid">
      {%- comment -%} Gallery {%- endcomment -%}
      <div class="product-gallery">
        <div class="product-gallery__main">
          {%- if product.featured_image -%}
            <img
              src="{{ product.featured_image | image_url: width: 1000 }}"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              data-product-main-image
              width="1000"
              height="1000"
              loading="eager"
            >
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
        {%- if product.images.size > 1 -%}
          <div class="product-gallery__thumbs">
            {%- for image in product.images -%}
              <button
                type="button"
                class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                data-product-thumb
                data-full-src="{{ image | image_url: width: 1000 }}"
                aria-label="Afbeelding {{ forloop.index }}"
              >
                <img
                  src="{{ image | image_url: width: 144 }}"
                  alt="{{ image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="72"
                  height="72"
                >
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Product info {%- endcomment -%}
      <div class="product-info">
        {%- if product.vendor != blank -%}
          <p class="product-info__vendor">{{ product.vendor }}</p>
        {%- endif -%}

        <h1>{{ product.title }}</h1>

        <div style="margin:0.75rem 0;">
          {%- assign review_count = product.metafields.reviews.rating_count | default: 128 -%}
          {%- assign review_rating = product.metafields.reviews.rating | default: 5 -%}
          {%- render 'star-rating', rating: review_rating, count: review_count -%}
        </div>

        <div style="margin:1rem 0;">
          {%- render 'price', product: product -%}
        </div>

        {%- if settings.show_urgency_badges -%}
          <p style="margin-bottom:1rem;">
            <span class="badge badge--popular">{{ 'products.popular' | t }}</span>
            {%- assign inventory = product.selected_or_first_available_variant.inventory_quantity -%}
            {%- if inventory > 0 and inventory <= 10 -%}
              <span class="badge badge--stock">{{ 'products.low_stock' | t }}</span>
            {%- elsif product.available -%}
              <span class="badge" style="background:#d4edda;color:#155724;">{{ 'products.in_stock' | t }}</span>
            {%- endif -%}
          </p>
        {%- endif -%}

        <ul class="product-info__benefits">
          {%- for block in section.blocks -%}
            {%- if block.type == 'benefit' -%}
              <li {{ block.shopify_attributes }}>
                {%- render 'icon', icon: 'check' -%}
                {{ block.settings.text }}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        {% form 'product', product, data-product-form: '' %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div class="form-group">
                <label class="form-label" for="option-{{ forloop.index }}">{{ option.name }}</label>
                <select class="form-select" id="option-{{ forloop.index }}" name="options[{{ option.name | escape }}]">
                  {%- for value in option.values -%}
                    <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endfor -%}
          {%- endunless -%}

          {%- render 'quantity-selector' -%}

          <button
            type="submit"
            class="btn btn--primary btn--full btn--large"
            {% unless product.available %}disabled{% endunless %}
          >
            {%- if product.available -%}
              {{ 'general.add_to_cart' | t }}
            {%- else -%}
              {{ 'general.sold_out' | t }}
            {%- endif -%}
          </button>
        {% endform %}

        <div style="margin:1.25rem 0;">
          {%- render 'trust-badges' -%}
        </div>

        <div class="product-shipping-info">
          <p><strong>🚚 Verzending:</strong> Gratis bij bestellingen vanaf €{{ settings.free_shipping_threshold }}. Levering binnen 1-3 werkdagen.</p>
          <p><strong>↩️ Retourneren:</strong> 30 dagen bedenktijd, gratis retourneren.</p>
        </div>

        <div style="margin-top:1rem;">
          {%- render 'payment-icons' -%}
        </div>
      </div>
    </div>

    {%- comment -%} Tabs {%- endcomment -%}
    <div class="product-tabs" data-tabs>
      <div class="product-tabs__nav" role="tablist">
        <button class="product-tabs__btn is-active" data-tab-btn="description" role="tab">{{ 'products.description' | t }}</button>
        <button class="product-tabs__btn" data-tab-btn="reviews" role="tab">{{ 'products.reviews' | t }}</button>
        <button class="product-tabs__btn" data-tab-btn="faq" role="tab">{{ 'products.faq' | t }}</button>
        <button class="product-tabs__btn" data-tab-btn="shipping" role="tab">{{ 'products.shipping_returns' | t }}</button>
      </div>

      <div class="product-tabs__panel is-active rte" data-tab-panel="description" role="tabpanel">
        {{ product.description }}
      </div>

      <div class="product-tabs__panel" data-tab-panel="reviews" role="tabpanel">
        <div class="reviews__grid" style="grid-template-columns:1fr;">
          {%- for i in (1..3) -%}
            <div class="review-card">
              <div class="review-card__header">
                <div class="review-card__avatar">K</div>
                <div>
                  <div class="review-card__name">Klant {{ i }}</div>
                  <div class="review-card__date">Geverifieerde aankoop</div>
                </div>
              </div>
              {%- render 'star-rating', rating: 5 -%}
              <p class="review-card__text" style="margin-top:0.75rem;">"Uitstekend product, precies wat ik zocht. Snelle levering en goede kwaliteit."</p>
            </div>
          {%- endfor -%}
        </div>
      </div>

      <div class="product-tabs__panel" data-tab-panel="faq" role="tabpanel">
        <div class="faq__list" data-faq-list>
          <div class="faq__item" data-faq-item>
            <button class="faq__question" data-faq-question aria-expanded="false">
              Past dit product bij mij?
              <span class="faq__icon">{%- render 'icon', icon: 'plus' -%}</span>
            </button>
            <div class="faq__answer">Bekijk de productspecificaties en afmetingen in de beschrijving. Twijfel je? Neem contact op met onze klantenservice.</div>
          </div>
          <div class="faq__item" data-faq-item>
            <button class="faq__question" data-faq-question aria-expanded="false">
              Is dit product op voorraad?
              <span class="faq__icon">{%- render 'icon', icon: 'plus' -%}</span>
            </button>
            <div class="faq__answer">Ja, zolang de knop "In winkelwagen" actief is, is het product op voorraad en direct leverbaar.</div>
          </div>
        </div>
      </div>

      <div class="product-tabs__panel rte" data-tab-panel="shipping" role="tabpanel">
        <h3>Verzending</h3>
        <p>Bestellingen worden binnen 1-3 werkdagen geleverd in Nederland en België. Gratis verzending bij bestellingen vanaf €{{ settings.free_shipping_threshold }}.</p>
        <h3>Retourneren</h3>
        <p>Niet tevreden? Retourneer je product binnen 30 dagen, zonder gedoe. Retourneren is gratis.</p>
      </div>
    </div>
  </div>
</section>

{%- comment -%} Sticky ATC mobile {%- endcomment -%}
<div class="sticky-atc" data-sticky-atc>
  <div class="sticky-atc__inner">
    <div class="sticky-atc__info">
      <div class="sticky-atc__title">{{ product.title }}</div>
      {%- render 'price', product: product -%}
    </div>
    <button type="button" class="btn btn--primary" onclick="document.querySelector('[data-product-form] [type=submit]').click()">
      {{ 'general.add_to_cart' | t }}
    </button>
  </div>
</div>

{% schema %}
{
  "name": "Product",
  "blocks": [
    {
      "type": "benefit",
      "name": "Voordeel",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Tekst",
          "default": "Premium kwaliteit materiaal"
        }
      ]
    }
  ],
  "settings": []
}
{% endschema %}
