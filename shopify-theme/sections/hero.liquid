<section class="hero" aria-label="Hero">
  <div class="hero__bg">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 1920 }}"
        alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
        loading="eager"
        width="1920"
        height="1080"
      >
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
    <div class="hero__overlay"></div>
  </div>

  <div class="container">
    <div class="hero__content">
      {%- if section.settings.subheading != blank -%}
        <p class="section__subtitle" style="color:var(--color-secondary);">{{ section.settings.subheading }}</p>
      {%- endif -%}
      <h1>{{ section.settings.heading | default: 'Ontdek premium producten voor jouw levensstijl' }}</h1>
      <p>{{ section.settings.text | default: 'Zorgvuldig geselecteerd, snel geleverd en met de zekerheid van 30 dagen retourneren.' }}</p>
      <div class="hero__actions">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--primary btn--large">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a href="{{ section.settings.button_link_2 }}" class="btn btn--secondary btn--large" style="color:#fff;border-color:#fff;">
            {{ section.settings.button_label_2 }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Achtergrondafbeelding"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtitel",
      "default": "Nieuw — Premium collectie"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Ontdek premium producten voor jouw levensstijl"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Tekst",
      "default": "Zorgvuldig geselecteerd, snel geleverd en met de zekerheid van 30 dagen retourneren."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Knop tekst",
      "default": "Shop nu"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Knop link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Tweede knop tekst",
      "default": "Bekijk bestsellers"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Tweede knop link"
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
