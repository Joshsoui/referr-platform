<div class="page-header">
  <div class="container">
    {%- render 'breadcrumb', page: page -%}
    <h1>{{ page.title | default: 'contact.title' | t }}</h1>
    <p class="text-muted">We helpen je graag. Gemiddelde reactietijd: minder dan 24 uur.</p>
  </div>
</div>

<section class="section" style="padding-top:0;">
  <div class="container">
    <div class="contact-info">
      <div class="contact-info__item">
        <h3>E-mail</h3>
        <p class="text-muted"><a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></p>
      </div>
      <div class="contact-info__item">
        <h3>Telefoon</h3>
        <p class="text-muted"><a href="tel:{{ settings.contact_phone }}">{{ settings.contact_phone }}</a></p>
      </div>
      <div class="contact-info__item">
        <h3>Openingstijden</h3>
        <p class="text-muted">{{ settings.business_hours }}</p>
      </div>
    </div>

    <div class="contact-form">
      {% form 'contact' %}
        {%- if form.posted_successfully? -%}
          <p style="padding:1rem;background:#d4edda;color:#155724;border-radius:var(--radius-sm);margin-bottom:1.5rem;">
            {{ 'contact.success' | t }}
          </p>
        {%- endif -%}

        {%- if form.errors -%}
          <p style="padding:1rem;background:#f8d7da;color:#721c24;border-radius:var(--radius-sm);margin-bottom:1.5rem;">
            {{ form.errors | default_errors }}
          </p>
        {%- endif -%}

        <div class="form-group">
          <label class="form-label" for="contact-name">{{ 'contact.name' | t }}</label>
          <input type="text" id="contact-name" name="contact[name]" class="form-input" required autocomplete="name">
        </div>

        <div class="form-group">
          <label class="form-label" for="contact-email">{{ 'contact.email' | t }}</label>
          <input type="email" id="contact-email" name="contact[email]" class="form-input" required autocomplete="email">
        </div>

        <div class="form-group">
          <label class="form-label" for="contact-message">{{ 'contact.message' | t }}</label>
          <textarea id="contact-message" name="contact[body]" class="form-textarea" required></textarea>
        </div>

        <button type="submit" class="btn btn--primary btn--full">{{ 'contact.send' | t }}</button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contactpagina",
  "settings": []
}
{% endschema %}
