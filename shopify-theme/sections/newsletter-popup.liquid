<div class="newsletter-popup" data-newsletter-popup role="dialog" aria-modal="true" aria-labelledby="popup-title">
  <div class="newsletter-popup__card">
    <button class="newsletter-popup__close" data-popup-close aria-label="{{ 'general.close' | t }}">&times;</button>
    <h2 id="popup-title">{{ settings.newsletter_popup_title }}</h2>
    <p class="text-muted">{{ settings.newsletter_popup_text }}</p>

    {% form 'customer' %}
      <input type="hidden" name="contact[tags]" value="newsletter,popup">
      <div class="newsletter__form" style="margin-top:1.5rem;">
        <input
          type="email"
          name="contact[email]"
          class="newsletter__input"
          placeholder="{{ 'newsletter.placeholder' | t }}"
          required
          autocomplete="email"
        >
        <button type="submit" class="btn btn--primary btn--full">{{ 'newsletter.submit' | t }}</button>
      </div>
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Nieuwsbrief pop-up",
  "settings": []
}
{% endschema %}
