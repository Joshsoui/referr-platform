<div class="quantity-selector">
  <button type="button" class="quantity-selector__btn" data-quantity-minus aria-label="Minder">−</button>
  <input
    type="number"
    name="quantity"
    class="quantity-selector__input"
    value="1"
    min="1"
    data-quantity-input
    aria-label="{{ 'products.quantity' | t }}"
  >
  <button type="button" class="quantity-selector__btn" data-quantity-plus aria-label="Meer">+</button>
</div>
