{%- liquid
  assign og_title = page_title | default: settings.seo_default_title
  assign og_description = page_description | default: settings.seo_default_description
  assign og_image = page_image | default: settings.logo
-%}

<title>
  {%- if page_title != blank -%}
    {{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}
  {%- else -%}
    {{ settings.seo_default_title }}
  {%- endif -%}
</title>

{%- if og_description != blank -%}
  <meta name="description" content="{{ og_description | escape }}">
{%- endif -%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
{%- if og_description != blank -%}
  <meta property="og:description" content="{{ og_description | escape }}">
{%- endif -%}
{%- if og_image != blank -%}
  <meta property="og:image" content="http:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
{%- if og_description != blank -%}
  <meta name="twitter:description" content="{{ og_description | escape }}">
{%- endif -%}
