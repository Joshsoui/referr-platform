<div class="trust-badges" role="list">
  <div class="trust-badge" role="listitem">
    {%- render 'icon', icon: 'shipping' -%}
    <span>{{ settings.usp_1_title }}</span>
  </div>
  <div class="trust-badge" role="listitem">
    {%- render 'icon', icon: 'return' -%}
    <span>{{ settings.usp_2_title }}</span>
  </div>
  <div class="trust-badge" role="listitem">
    {%- render 'icon', icon: 'shield' -%}
    <span>{{ settings.usp_3_title }}</span>
  </div>
  <div class="trust-badge" role="listitem">
    {%- render 'icon', icon: 'support' -%}
    <span>{{ settings.usp_4_title }}</span>
  </div>
</div>
